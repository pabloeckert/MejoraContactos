# Copiar a .env (nunca se commitea, ver .gitignore) y completar acá, nunca
# en el chat ni en config.yaml.

GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Sincronización del contacto final hacia Supabase (contactos_finales) --
# opcional. Sin esto, motor-contactos sigue funcionando exactamente igual,
# solo que no empuja nada hacia afuera (ver motor/supabase_sync.py).
# SUPABASE_SERVICE_ROLE_KEY es la key SECRETA de service role del proyecto
# (Supabase → Project Settings → API → service_role) -- NUNCA la anon/
# publishable key (esa es la que ya usa la app web en su propio .env, es
# pública a propósito). Esta bypassea Row Level Security, así que solo debe
# vivir acá (server-side, nunca commiteada) y en la Edge Function
# contactos-api (se la inyecta Supabase solo, no hace falta configurarla ahí
# a mano).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
